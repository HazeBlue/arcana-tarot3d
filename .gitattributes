# 统一换行符：仓库内一律存 LF，检出到 Windows 时自动转成 CRLF
* text=auto eol=lf

# 图片等二进制文件不做换行处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary

# 这些文件在 Windows 上也保持 LF，避免 shell 脚本出错
*.sh text eol=lf
*.bash text eol=lf

# 语言统计排除
package-lock.json linguist-generated=true
